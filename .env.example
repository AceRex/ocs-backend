# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ocs?retryWrites=true&w=majority

# Authentication (REQUIRED: Generate a cryptographically secure random key, e.g. using `openssl rand -hex 32`)
JWT_SECRET=<REQUIRED_GENERATE_RANDOM_SECRET_MIN_32_CHARS>
JWT_EXPIRY=30d
GRACE_PERIOD_MONTHS=3

# Frontend & CORS
FRONTEND_URL=https://churchocs.com
PORT=5001
NODE_ENV=development

# Cloudinary (REQUIRED for avatar and media uploads)
# CLOUDINARY_CLOUD_NAME=<your_cloud_name>
# CLOUDINARY_API_KEY=<your_api_key>
# CLOUDINARY_API_SECRET=<your_api_secret>

# Email Notifications (for instant ticket alerts)
NOTIFICATION_EMAILS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=support@example.com
# SMTP_PASS=your_gmail_app_password
# FROM_EMAIL="OCS Support" <support@example.com>

# Google OAuth audience (must match the web client ID)
GOOGLE_CLIENT_ID=
# Additional exact browser origins, comma-separated
CORS_ALLOWED_ORIGINS=

# Flutterwave v3 Standard (server-only secrets, never VITE_/EXPO_PUBLIC_ variables)
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=
FLW_CURRENCY=
# Amounts in the currency's major unit. Set your actual prices; no demo prices.
FLW_PLAN_PRICES={}
# Shape: {"standard":{"monthly":1000,"semi-annual":5000,"annually":9000}}
# Production payments require MongoDB replica-set transactions (e.g. MongoDB Atlas).
